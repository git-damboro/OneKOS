# OneKOS 运行配置。复制为 .env 后填写；请勿提交真实密钥。
PORT=4173

# 飞书企业自建应用与多维表格
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_APP_TOKEN=G3W9bPQLzaGD5zs5zz1cVh3znme
FEISHU_TABLE_ONBOARDING_SESSIONS=
FEISHU_OAUTH_REDIRECT_URI=

# OpenAI-compatible 模型服务
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
LLM_ENABLE_THINKING=false

# 上传视频解析。默认复用 LLM_BASE_URL/LLM_API_KEY；只有使用不同百炼工作空间时才填写 MEDIA_AI_*。
MEDIA_AI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
MEDIA_AI_COMPATIBLE_BASE_URL=
MEDIA_AI_API_KEY=
ASR_MODEL=fun-asr-flash-2026-06-15
VISION_MODEL=qwen3-vl-flash
MEDIA_AI_TIMEOUT_MS=90000
VISION_FRAME_INTERVAL_SEC=2
VISION_MAX_FRAMES=8

# 本地视频剪辑。Windows 推荐填写正斜杠绝对路径；服务器可改为 /usr/bin/ffmpeg。
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WORK_DIR=output/video-jobs
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=30
VIDEO_FONT_DIR=C:/Windows/Fonts
VIDEO_FONT_NAME=Microsoft YaHei
